hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=http://raw.githubusercontent.com/thhhh-hieu/kcogi/refs/heads/main/bancaideogi.js, requires-body=true, max-size=524288, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=http://raw.githubusercontent.com/thhhh-hieu/kcogi/refs/heads/main/xoaxoaxoa.js, timeout=60


revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=http://raw.githubusercontent.com/thhhh-hieu/kcogi/refs/heads/main/d_th.js, requires-body=true, max-size=-1, timeout=60
